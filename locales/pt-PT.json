    { "id": "help.keys.primary", "text": "F1 Ajuda | F2 pesquisar comandos | F4 ação principal | F5 atualizar" },
    { "id": "help.keys.regions", "text": "F6 alterna regiões | F7 foca o filtro partilhado de caminhos alterados" },
    { "id": "help.keys.search", "text": "Ctrl+F pesquisa o diff atual | F3/Shift+F3 percorre os resultados" },
    { "id": "help.keys.repository", "text": "F8 ramos/worktrees | F9 stashes/patches | Ctrl+Q sair" },
    { "id": "help.keys.menu", "text": "F10 abre o menu completo; as suas ações usam a mesma disponibilidade atual do F2." },
    { "id": "help.keys.refresh", "text": "As alterações externas no worktree e no Git são atualizadas automaticamente; F5 atualiza de imediato." },
    { "id": "help.keys.remotes", "text": "Remotos: cabeçalho ou F2 | fetch, push e prune mantêm stdout e stderr separados" },
    { "id": "help.keys.index", "text": "S preparar | U anular preparação | A preparar tudo | Shift+U anular tudo" },
    { "id": "help.keys.diff", "text": "[ / ] contexto do diff | P preparar hunks não controlados | L linhas selecionadas | R reverter" },
    { "id": "help.keys.hunks", "text": "J/K percorre hunks | Ctrl+Z anula a última reversão exata" },
    { "id": "help.keys.conflict-choices", "text": "Conflito: Alt+O nosso | Alt+T deles | Alt+B base | Alt+A ambos" },
    { "id": "help.keys.conflict-actions", "text": "Conflito: Alt+N seguinte | Alt+X modo do ficheiro | Alt+S preparar resultado resolvido" },
    { "id": "help.mouse", "text": "Rato: focar e selecionar linhas, ativar botões, selecionar texto, deslocar e redimensionar janelas." },
    { "id": "help.note.palette", "text": "A paleta de comandos também apresenta ações indisponíveis e explica o motivo atual." },
    { "id": "help.note.destructive", "text": "As ações destrutivas abrem confirmações com Cancelar selecionado primeiro e mostram o alvo exato." },
    { "id": "help.note.read-only", "text": "Os editores de diff e stash são só de leitura; as alterações usam os bytes Git exatos preservados." },
    { "id": "help.note.doctor-json", "text": "Utilize git tui doctor --json fora da TUI para obter o relatório estável legível por máquina." },
    { "id": "help.binding.close", "text": "Fechar ajuda" },
    { "id": "chooser.help.title", "text": "Ajuda do seletor de repositório" },
    { "id": "chooser.help.open", "text": "Abrir aceita a raiz de um repositório ou qualquer diretório dentro de um worktree." },
    { "id": "chooser.help.recent", "text": "Os caminhos recentes são guardados na configuração global do Git e mantêm a identidade nativa exata." },
    { "id": "chooser.help.clone", "text": "O clone padrão usa a otimização local normal do Git. A cópia completa desativa hardlinks." },
    { "id": "chooser.help.shared", "text": "O clone partilhado utiliza objetos da origem e pode ficar corrompido se a origem os perder." },
    { "id": "chooser.help.submodules", "text": "Os submódulos recursivos delegam totalmente a inicialização e a recursão ao Git." },
    { "id": "chooser.help.cleanup", "text": "Os novos destinos falhados só podem ser removidos enquanto as identidades do destino e do pai ainda coincidirem." },
    { "id": "chooser.help.navigation", "text": "Tab e Shift+Tab movem o foco. Enter e rato ativam controlos. Ctrl+Q sai." },
