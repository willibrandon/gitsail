    { "id": "help.keys.primary", "text": "F1 Guida | F2 cerca comandi | F4 azione principale | F5 aggiorna" },
    { "id": "help.keys.regions", "text": "F6 cambia area | F7 attiva il filtro condiviso dei percorsi modificati" },
    { "id": "help.keys.search", "text": "Ctrl+F cerca nel diff corrente | F3/Shift+F3 passa tra le corrispondenze" },
    { "id": "help.keys.repository", "text": "F8 branch/worktree | F9 stash/patch | Ctrl+Q esci" },
    { "id": "help.keys.menu", "text": "F10 apre il menu completo; le sue azioni usano la stessa disponibilità aggiornata di F2." },
    { "id": "help.keys.refresh", "text": "Le modifiche esterne al worktree e a Git si aggiornano automaticamente; F5 aggiorna subito." },
    { "id": "help.keys.remotes", "text": "Remoti: intestazione o F2 | fetch, push e prune mantengono separati stdout e stderr" },
    { "id": "help.keys.index", "text": "S prepara | U rimuovi | A prepara tutto | Shift+U rimuovi tutto" },
    { "id": "help.keys.diff", "text": "[ / ] contesto diff | P prepara hunk non tracciati | L righe selezionate | R ripristina" },
    { "id": "help.keys.hunks", "text": "J/K naviga tra gli hunk | Ctrl+Z annulla l'ultimo ripristino esatto" },
    { "id": "help.keys.conflict-choices", "text": "Conflitto: Alt+O nostri | Alt+T loro | Alt+B base | Alt+A entrambi" },
    { "id": "help.keys.conflict-actions", "text": "Conflitto: Alt+N successivo | Alt+X modalità file | Alt+S prepara il risultato risolto" },
    { "id": "help.mouse", "text": "Mouse: attiva e seleziona righe, aziona pulsanti, seleziona testo, scorre e ridimensiona finestre." },
    { "id": "help.note.palette", "text": "La tavolozza dei comandi elenca anche le azioni non disponibili e ne spiega il motivo attuale." },
    { "id": "help.note.destructive", "text": "Le azioni distruttive aprono conferme con Annulla preselezionato e mostrano la destinazione esatta." },
    { "id": "help.note.read-only", "text": "Gli editor di diff e stash sono di sola lettura; le modifiche usano i byte Git esatti conservati." },
    { "id": "help.note.doctor-json", "text": "Usa git tui doctor --json fuori dalla TUI per il rapporto stabile leggibile dal computer." },
