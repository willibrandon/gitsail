<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>git-tui</AssemblyName>
    <RootNamespace>GitSail</RootNamespace>
    <PackageId>GitSail</PackageId>
    <Title>GitSail</Title>
    <Description>A cross-platform Git GUI experience for the terminal with first-class keyboard and mouse support.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>git;tui;terminal;native-aot</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>git-tui</ToolCommandName>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <CreateRidSpecificToolPackages>true</CreateRidSpecificToolPackages>
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
    <StackTraceLineNumberSupport>true</StackTraceLineNumberSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <MetricsSupport>true</MetricsSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <GitSailRequireCompleteLocales>true</GitSailRequireCompleteLocales>
    <StripSymbols>true</StripSymbols>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The exact dependency graph omits producer-side marker metadata; RID-native publish and execution prove compatibility. -->
    <NoWarn>$(NoWarn);IL3058</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <CETCompat>true</CETCompat>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <ToolCommandRunner>dotnet</ToolCommandRunner>
    <ToolEntryPoint>GitSail.ToolLauncher.dll</ToolEntryPoint>
    <PackAsToolShimRuntimeIdentifiers>$(RuntimeIdentifier)</PackAsToolShimRuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GitSailGlibcSysRootRoot)' != '' And '$(RuntimeIdentifier)' == 'linux-x64'">
    <SysRoot>$([MSBuild]::NormalizeDirectory('$(GitSailGlibcSysRootRoot)', 'rootfs'))</SysRoot>
    <GitSailGccToolchainRoot>$([MSBuild]::NormalizeDirectory('$(SysRoot)', 'usr', 'lib', 'gcc', 'x86_64-linux-gnu', '7'))</GitSailGccToolchainRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GitSailGlibcSysRootRoot)' != '' And '$(RuntimeIdentifier)' == 'linux-arm64'">
    <SysRoot>$([MSBuild]::NormalizeDirectory('$(GitSailGlibcSysRootRoot)', 'rootfs'))</SysRoot>
    <GitSailGccToolchainRoot>$([MSBuild]::NormalizeDirectory('$(SysRoot)', 'usr', 'lib', 'gcc', 'aarch64-linux-gnu', '7'))</GitSailGccToolchainRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hex1b" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <LinkerArg Include="/Brepro" />
    <LinkerArg Include="/PDBTHREADS:1" />
  </ItemGroup>

  <ItemGroup Condition="'$(GitSailGccToolchainRoot)' != '' And
                        ('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64')">
    <LinkerArg Include="-B$(GitSailGccToolchainRoot)/" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../locales/*.json" />
    <CompilerVisibleProperty Include="GitSailRequireCompleteLocales" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitSail.ToolLauncher/GitSail.ToolLauncher.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitSail.UnitTests" />
    <InternalsVisibleTo Include="GitSail.ServiceTests" />
    <InternalsVisibleTo Include="GitSail.UiTests" />
    <InternalsVisibleTo Include="GitSail.AotTests" />
    <InternalsVisibleTo Include="GitSail.SecurityTests" />
    <InternalsVisibleTo Include="GitSail.PerformanceTests" />
    <InternalsVisibleTo Include="GitSail.CompatibilityTests" />
    <InternalsVisibleTo Include="GitSail.PackageTests" />
  </ItemGroup>

  <Target Name="RemoveNonRuntimeFilesFromRidToolPackage"
          AfterTargets="PackTool"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <TfmSpecificPackageFile Remove="$(PublishDir)$(AssemblyName).xml" />
      <TfmSpecificPackageFile Remove="$(PublishDir)$(AssemblyName).pdb" />
      <TfmSpecificPackageFile Remove="$(PublishDir)$(AssemblyName).dbg" />
      <TfmSpecificPackageFile Remove="$(PublishDir)$(AssemblyName).dSYM/**/*" />
      <_NonRuntimeRidToolPackageFile Include="@(TfmSpecificPackageFile)"
                                    Condition="'%(Filename)%(Extension)' == '$(AssemblyName).xml' Or
                                               '%(Extension)' == '.pdb' Or
                                               '%(Extension)' == '.dbg' Or
                                               $([System.String]::Copy('%(Identity)').Contains('$(AssemblyName).dSYM/'))" />
    </ItemGroup>
    <Error Condition="'@(_NonRuntimeRidToolPackageFile)' != ''"
           Text="RID tool package contains non-runtime files: @(_NonRuntimeRidToolPackageFile, ', ')" />
  </Target>

  <Target Name="RemoveUnusedTerminalChildProcessAssets"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_UnusedTerminalChildProcessAsset Include="$(PublishDir)hex1bpty.exe"
                                        Condition="Exists('$(PublishDir)hex1bpty.exe')" />
      <_UnusedTerminalChildProcessAsset Include="$(PublishDir)libhex1binterop.dylib"
                                        Condition="Exists('$(PublishDir)libhex1binterop.dylib')" />
      <_UnusedTerminalChildProcessAsset Include="$(PublishDir)libhex1binterop.so"
                                        Condition="Exists('$(PublishDir)libhex1binterop.so')" />
    </ItemGroup>
    <Delete Files="@(_UnusedTerminalChildProcessAsset)" />
  </Target>

  <Target Name="RecordNativeAotToolchainInvocation"
          AfterTargets="LinkNative"
          Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' != ''">
    <WriteLinesToFile File="$(NativeIntermediateOutputPath)git-tui.ilc-path.txt"
                      Lines="$(IlcToolsPath)ilc$(_NativeExecutableExtension)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(NativeIntermediateOutputPath)git-tui.linker-path.txt"
                      Lines="$(CppLinker)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(NativeIntermediateOutputPath)git-tui.linker.rsp"
                      Lines="@(CustomLinkerArg)"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

  <Target Name="AddWindowsToolLauncherToRidPackage"
          AfterTargets="PackTool"
          Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PropertyGroup>
      <_ToolLauncherOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'GitSail.ToolLauncher', 'bin', '$(Configuration)', 'net10.0'))</_ToolLauncherOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_ToolLauncherFile Include="$(_ToolLauncherOutputDirectory)GitSail.ToolLauncher.dll" />
      <_ToolLauncherFile Include="$(_ToolLauncherOutputDirectory)GitSail.ToolLauncher.deps.json" />
      <_ToolLauncherFile Include="$(_ToolLauncherOutputDirectory)GitSail.ToolLauncher.runtimeconfig.json" />
      <TfmSpecificPackageFile Include="@(_ToolLauncherFile)">
        <PackagePath>tools/$(_ToolPackShortTargetFrameworkName)/$(RuntimeIdentifier)/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
    <Error Condition="!Exists('%(_ToolLauncherFile.Identity)')"
           Text="The Windows tool launcher output is missing: %(_ToolLauncherFile.Identity)" />
  </Target>

  <Target Name="CreateWindowsRidToolShim"
          AfterTargets="GenerateShimsAssets"
          BeforeTargets="PackTool"
          Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PropertyGroup>
      <_WindowsToolShimPath>$([MSBuild]::NormalizePath('$(PackagedShimOutputRootDirectory)', 'shims', '$(_ToolPackShortTargetFrameworkName)', '$(RuntimeIdentifier)', 'git-tui.exe'))</_WindowsToolShimPath>
      <_WindowsToolLauncherRelativePath>.store/gitsail/$(Version)/gitsail.$(RuntimeIdentifier)/$(Version)/tools/any/$(RuntimeIdentifier)/GitSail.ToolLauncher.dll</_WindowsToolLauncherRelativePath>
    </PropertyGroup>
    <ItemGroup>
      <_WindowsToolAppHost Include="@(_ApphostsForShimRuntimeIdentifiers)"
                          Condition="'%(RuntimeIdentifier)' == '$(RuntimeIdentifier)'" />
    </ItemGroup>
    <Error Condition="'@(_WindowsToolAppHost)' == ''"
           Text="The restored Windows apphost for $(RuntimeIdentifier) is missing." />
    <CreateAppHost AppHostSourcePath="@(_WindowsToolAppHost)"
                   AppHostDestinationPath="$(_WindowsToolShimPath)"
                   AppBinaryName="$(_WindowsToolLauncherRelativePath)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="false"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
                   EnableMacOSCodeSign="false"
                   DisableCetCompat="false" />
  </Target>
</Project>
